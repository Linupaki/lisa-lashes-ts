generator client {
  provider = "prisma-client-js"
  }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id              Int               @id @default(autoincrement())
  first_name      String
  last_name       String
  phone           String            @unique
  address         String?           @unique
  password_hash   String
  role            user_roles        @default(user)
  bookings        bookings[]
  carts           carts?
  course_bookings course_bookings[]
  orders          orders[]
  promo_code_uses promo_code_uses[]
  resources       resources?
  reviews         reviews[]
}

model resources {
  id                 Int                  @id @default(autoincrement())
  name               String
  active             Boolean              @default(true)
  user_id            Int?                 @unique
  bookings           bookings[]
  resource_services  resource_services[]
  users              users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  schedule_overrides schedule_overrides[]
  working_hours      working_hours[]
}

model bookings {
  id             Int             @id @default(autoincrement())
  resource_id    Int
  customer_name  String
  customer_phone String?
  customer_email String?
  start_time     DateTime        @db.Timestamptz(6)
  end_time       DateTime        @db.Timestamptz(6)
  status         booking_status  @default(confirmed)
  service_id     Int?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  user_id        Int?
  resources      resources       @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salon_services salon_services? @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  updated_at DateTime     @default(now()) @db.Timestamptz(6)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int      @default(1)
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cart_id, product_id])
}

model orders {
  id                  Int           @id @default(autoincrement())
  user_id             Int
  total               Decimal       @db.Decimal(10, 2)
  status              String        @default("pending")
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  customer_first_name String?
  customer_last_name  String?
  customer_email      String?
  customer_phone      String?
  delivery_method     String?
  delivery_address1   String?
  delivery_address2   String?
  delivery_city       String?
  delivery_eircode    String?
  payment_method      String?
  order_note          String?
  order_items         order_items[]
  users               users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model order_items {
  id                Int      @id @default(autoincrement())
  order_id          Int
  product_id        Int
  price_at_purchase Decimal  @db.Decimal(10, 2)
  quantity          Int
  orders            orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model product_types {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  products   products[]
}

model products {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  price             Decimal            @db.Decimal(10, 2)
  stock             Int                @default(0)
  category          String
  in_slider         Boolean            @default(false)
  path              String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  product_type_id   Int?
  status            product_status     @default(draft)
  cart_items        cart_items[]
  order_items       order_items[]
  product_discount  product_discounts?
  product_images    product_images[]
  product_sections  product_sections[]
  product_type      product_types?     @relation(fields: [product_type_id], references: [id])
  reviews           reviews[]
}

model product_images {
  id         Int      @id @default(autoincrement())
  product_id Int
  path       String
  created_at DateTime @default(now())
  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model reviews {
  id                Int             @id @default(autoincrement())
  product_id        Int?
  service_id        Int?
  user_id           Int
  rating            Int
  comment           String
  status            review_status   @default(pending)
  in_slider         Boolean         @default(false)
  slider_image_path String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt
  review_images     review_images[]
  product           products?       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  service           salon_services? @relation(fields: [service_id], references: [id], onDelete: Cascade)
  user              users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@unique([service_id, user_id])
}

model review_images {
  id         Int      @id @default(autoincrement())
  review_id  Int
  path       String
  created_at DateTime @default(now())
  review     reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade)
}

model resource_services {
  resource_id    Int
  service_id     Int
  resources      resources      @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salon_services salon_services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resource_id, service_id])
}

model salon_services {
  id                Int                 @id @default(autoincrement())
  name              String
  price             Decimal             @db.Decimal(10, 2)
  active            Boolean             @default(true)
  duration_minutes  Int                 @default(60)
  bookings          bookings[]
  resource_services resource_services[]
  reviews           reviews[]
}

model schedule_overrides {
  id          Int       @id @default(autoincrement())
  resource_id Int
  date        DateTime  @db.Date
  working     Boolean   @default(true)
  start_time  DateTime? @db.Time(6)
  end_time    DateTime? @db.Time(6)
  note        String?
  resources   resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resource_id, date])
}

model working_hours {
  id          Int       @id @default(autoincrement())
  resource_id Int
  weekday     Int       @db.SmallInt
  start_time  DateTime  @db.Time(6)
  end_time    DateTime  @db.Time(6)
  resources   resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resource_id, weekday])
}

model promo_codes {
  id                  Int               @id @default(autoincrement())
  code                String            @unique @db.VarChar(50)
  discount_type       String            @db.VarChar(20)
  discount_value      Decimal           @db.Decimal(10, 2)
  max_uses            Int?
  used_count          Int?              @default(0)
  starts_at           DateTime?         @default(now()) @db.Timestamp(6)
  expires_at          DateTime?         @db.Timestamp(6)
  is_active           Boolean?          @default(true)
  single_use_per_user Boolean           @default(false)
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  updated_at          DateTime?         @default(now()) @db.Timestamp(6)
  promo_code_uses     promo_code_uses[]
}

model promo_code_uses {
  id         Int         @id @default(autoincrement())
  promo_id   Int
  user_id    Int
  created_at DateTime    @default(now())
  promo_code promo_codes @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([promo_id, user_id])
}

model about_blocks {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String?
  content_html String   @default("")
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  body         String   @default("[]")
  image_path   String?
  type         String   @default("intro")
}

model course_bookings {
  id         Int            @id @default(autoincrement())
  course_id  Int
  user_id    Int
  status     booking_status
  created_at DateTime       @default(now())
  course     courses        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user       users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([course_id, user_id])
}

model courses {
  id              Int               @id @default(autoincrement())
  title           String
  description     String?
  instructor      String?
  date            DateTime?
  time_start      String?
  time_end        String?
  location        String?
  spots           Int?
  price           Decimal           @db.Decimal(10, 2)
  certificate     Boolean           @default(false)
  image_path      String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  course_bookings course_bookings[]
}

model product_discounts {
  id             Int            @id @default(autoincrement())
  product_id     Int            @unique
  discount_value Decimal
  discount_type  discount_types
  discount_label String
  start_time     DateTime       @default(now())
  end_time       DateTime       @default(now())
  product        products       @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model product_sections {
  id           Int      @id @default(autoincrement())
  product_id   Int
  title        String
  slug         String?
  content_html String
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model gallery_items {
  id         Int      @id @default(autoincrement())
  title      String
  image_path String
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum booking_status {
  pending
  confirmed
  cancelled
  completed
}

enum user_roles {
  user
  admin
  master
}

enum review_status {
  pending
  approved
  hidden
}

enum discount_types {
  fixed
  percentage
}

enum product_status {
  active
  hidden
  draft
}
